# OrderTrofy Frontend Environment Variables
#
# Development (with Vite dev server proxy to http://127.0.0.1:8000):
# Leave as /api/v1 (default)
VITE_API_URL=/api/v1

# Production Deployment (Cloudflare Pages):
# When deploying to Cloudflare Pages connecting to your live backend domain:
# VITE_API_URL=https://ordertrofy.store/api/v1
