# OrderTrofy Frontend Environment Variables
#
# Development (with Vite dev server proxy):
# VITE_API_URL=/api/v1
# VITE_BACKEND_URL=https://api.ordertrofy.store (or http://127.0.0.1:8000 for local backend)
VITE_API_URL=/api/v1
VITE_BACKEND_URL=https://api.ordertrofy.store

# Production Deployment (Cloudflare Pages / Vercel):
# When deploying to production connecting directly to your live backend domain:
# VITE_API_URL=https://api.ordertrofy.store/api/v1
