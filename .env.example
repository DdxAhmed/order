# Never commit real values. Generate independent random values for every environment.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-64-character-random-secret

# Database Configuration
# Local Windows development (standalone PostgreSQL on port 5433):
# DATABASE_URL=postgresql+asyncpg://steam_codes:password@127.0.0.1:5433/steam_codes
# DATABASE_URL_SYNC=postgresql+psycopg://steam_codes:password@127.0.0.1:5433/steam_codes
# Docker Compose internal networking:
DATABASE_URL=postgresql+asyncpg://steam_codes:change-me@postgres:5432/steam_codes
DATABASE_URL_SYNC=postgresql+psycopg://steam_codes:change-me@postgres:5432/steam_codes

# Symmetric Encryption Keys (Fernet)
MAIL_CREDENTIALS_KEY=replace-with-a-url-safe-32-byte-fernet-key
SALLA_TOKEN_KEY=

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_WEBHOOK_URL=https://codes.example.com/telegram/webhook

# Web Application URLs and Sessions
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
ADMIN_SESSION_HOURS=12
CUSTOMER_SESSION_MINUTES=60
ACTIVATION_TOKEN_HOURS=24
VERIFICATION_WAIT_SECONDS=600
RESULT_RETENTION_SECONDS=900
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
CADDY_DOMAIN=localhost

# Primary IMAP Mailbox (Optional)
IMAP_LABEL=primary-imap
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=mailbox@example.com
IMAP_PASSWORD=replace-with-mail-app-password

# Microsoft OAuth2 / Graph Delegated Mailbox (Optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=consumers
MICROSOFT_REDIRECT_URI=http://localhost:8000/admin/mailboxes/oauth/callback

# Salla Integration
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=
SALLA_APP_ID=
SALLA_API_VERIFICATION_ENABLED=false
SALLA_NOTIFICATION_POLL_SECONDS=60
SALLA_CUSTOMER_SESSION_MINUTES=60
SALLA_USAGE_MAX=5
SALLA_USAGE_PERIOD_SECONDS=86400
SALLA_USAGE_COOLDOWN_SECONDS=30

# PostgreSQL Container Credentials (used in compose.yaml)
POSTGRES_DB=steam_codes
POSTGRES_USER=steam_codes
POSTGRES_PASSWORD=replace-with-a-long-random-password
